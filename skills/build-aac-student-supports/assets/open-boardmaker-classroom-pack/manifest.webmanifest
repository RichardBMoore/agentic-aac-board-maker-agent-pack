{
  "name": "Open Boardmaker Classroom Player",
  "short_name": "Boardmaker",
  "description": "Local-first AAC board editor and classroom player.",
  "start_url": "player.html?classroom=1",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "window-controls-overlay"],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "orientation": "landscape",
  "icons": [
    {
      "src": "icons/open-boardmaker.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
