{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/validate_board_outputs.py"
            ],
            "timeout": 65
          }
        ]
      }
    ]
  }
}
