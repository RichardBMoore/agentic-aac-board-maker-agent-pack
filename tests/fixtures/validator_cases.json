          { "id": "btn-different", "label": "Different", "role": "repair", "function": "repair", "spokenText": "Different please", "searchTerm": "different" }
        ]
      }
    ],
    "sett": {
      "student": "Strengths, access preferences, and communication opportunities only.",
      "environment": "Local classroom, shared laptop, intermittent internet.",
      "task": "Participate in a shared lesson choice and explain thinking.",
      "tools": "Large buttons, TTS, keyboard fallback, text fallback."
    },
    "udl": {
      "engagement": ["choice", "repair"],
      "representation": ["symbols", "spoken labels"],
      "actionExpression": ["AAC selection", "keyboard"]
    },
    "differentiation": {
      "content": "Same concept, reduced access load.",
      "process": "Model, wait, accept multimodal responses.",
      "product": "Selection, comment, and teacher observation.",
      "environment": "Low-distraction student mode.",
      "support": "Team review before use."
    },
    "participationBarriers": [
      { "barrier": "Original task assumes speech.", "support": "Offer AAC response paths." }
    ],
    "evidencePlan": {
      "observable": ["choice", "comment", "repair"],
      "notJudgement": "Access support is context, not grading.",
      "export": "Anonymous teacher note."
    },
    "teacherNotes": {
      "modeling": "Model choices, wait, and respond.",
      "evidence": "Observe choice, comment, and repair.",
      "customisation": "Replace Choice A with local vocabulary."
    },
    "symbolStrategy": {
      "defaultSource": "ARASAAC search terms",
      "textFallback": true
    },
    "privacy": {
      "level": "anonymous",
      "containsSensitiveData": false
    },
    "attribution": [
      {
        "source": "ARASAAC",
        "licence": "CC BY-NC-SA",
        "note": "Confirm exact current licence wording before publication."
      }
    ]
  },
