        "buttons": [
          { "id": "btn-i-think", "label": "I think", "role": "core", "function": "comment", "spokenText": "I think", "searchTerm": "think" },
          { "id": "btn-choice-a", "label": "Choice A", "role": "fringe", "function": "choose", "spokenText": "Choice A", "searchTerm": "choice" },
