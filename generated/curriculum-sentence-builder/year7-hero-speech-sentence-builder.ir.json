  "teacherNotes": {
    "curriculum": "Supports Year 7 English speaking/listening by giving access to opinion, reasoning and evidence language for a short hero speech, and by letting the student assemble and rehearse a whole sentence rather than single words.",
    "customisation": "Replace the describing words and the hero name with the class text, film, novel or local hero being studied. Add the hero's name as a word button or let the student say it after 'My hero is'.",
    "repair": "Keep Undo, Start again and Help please available so the student can fix or restart the sentence without losing agency.",
    "use": "Use for planning, rehearsal or supported oral presentation. The student builds a sentence on one page, crosses to the describing-words page, then speaks the whole sentence. Do not treat the board as the student's full expressive system.",
    "modeling": "Model a complete sentence chain across both pages: My hero is … brave … because … helps others, then press Speak sentence. Accept partial sentences as valid drafting or rehearsal.",
    "evidence": "sentence built in the message bar; opinion/because/example selection; speak-sentence use; repair (undo, start again) or help request"
  },
  "symbolStrategy": {
    "defaultSource": "ARASAAC search terms",
    "textFallback": true,
    "customMediaPolicy": "teacher-owned local media only unless explicitly approved",
    "notes": "Search terms prioritise abstract curriculum language; teacher modelling, the sentence bar, and clear text labels matter more than decorative symbols."
  },
  "privacy": {
    "level": "anonymous",
    "containsSensitiveData": false
  },
