  "sett": {
    "student": "Student can use AAC to participate in shopping role-play or community access through greetings, requesting, asking, refusing, and help-seeking.",
    "environment": "Classroom role-play, school enterprise, or supervised community context with adult safety support and local-first device use.",
    "task": "Communicate during a familiar shopping routine while staying able to ask for help, wait, or finish.",
    "tools": "Nine-button board, stable help/stop/finished options, spoken labels, text fallback, and teacher evidence notes."
  },
  "udl": {
