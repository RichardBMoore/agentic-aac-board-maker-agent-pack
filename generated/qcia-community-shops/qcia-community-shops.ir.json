  "differentiation": {
    "content": "Preserve functional community participation while reducing speech and environmental access barriers.",
    "process": "Model key vocabulary, provide wait time, allow rehearsal/repetition, and accept multimodal communication.",
    "product": "Accept observed AAC selections, role-play evidence, photo/portfolio notes, or anonymous session summary.",
    "environment": "Use a calm, predictable, local-first layout with teacher controls separate from student choices.",
    "support": "Teaching, SLP, OT, family, and student/team review should personalise vocabulary and access before reliance."
  },
  "participationBarriers": [
    {
      "barrier": "Community routines assume speech, fast responses, money handling, and environmental noise.",
      "support": "Provide prepared functional phrases, help/safety language, wait time, and adult modelling."
    }
  ],
  "evidencePlan": {
