  "teacherNotes": {
    "schedule_order": "The first row and early second-row buttons are the routine sequence; the remaining buttons are expressive supports, not compliance controls.",
    "customisation": "Replace routine steps with the actual class morning sequence and photos if available and approved.",
    "not_full_aac_claim": "This is a visual schedule with communication supports. It is not a replacement for the student's full AAC system.",
    "evidence": "Note whether the student anticipates next steps, requests help/wait/change, or comments on readiness.",
    "modeling": "Point to schedule steps as they happen and model expressive messages, especially Wait, Help please, Change and Finished."
  },
