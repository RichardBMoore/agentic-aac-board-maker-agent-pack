  "differentiation": {
    "content": "Maintain student dignity and self-advocacy instead of simplifying to compliance language.",
    "process": "Model key vocabulary, provide wait time, allow rehearsal/repetition, and accept multimodal communication.",
    "product": "Accept observed communication attempts and local team notes outside the public resource file.",
    "environment": "Use a calm, predictable, local-first layout with no more than nine targets per page and teacher controls separate from student choices.",
    "support": "Teaching, SLP, OT, family, and student/team review should personalise vocabulary and access before reliance."
  },
  "participationBarriers": [
