  "teacherNotes": {
    "age_respectful": "Language is plain and secondary-appropriate. Avoid childish praise, token language or public commentary about private needs.",
    "privacy": "Do not log sensitive health, behaviour or family details in the file. Use separate approved school processes for confidential notes.",
    "repair": "Honour repair messages such as Not that, Different, Say it another way and Wait before repeating demands.",
    "navigation": "Page 1 is urgent needs and regulation; page 2 is repair and self-advocacy. Help please is on both pages so support is always one selection away.",
    "use": "Use as a support for needs and communication repair, not as a behaviour-control board or replacement AAC system.",
    "modeling": "Model the board neutrally during calm moments, including how to move between the two pages. Treat selections as communication, not behaviour compliance.",
    "evidence": "support request; privacy request; repair message; refusal; question or disagreement"
  },
  "symbolStrategy": {
    "defaultSource": "ARASAAC search terms",
    "textFallback": true,
    "customMediaPolicy": "teacher-owned local media only unless explicitly approved",
    "notes": "Use simple, respectful symbols or text. Avoid infantilising cartoons for secondary students unless the student prefers them."
  },
  "privacy": {
    "level": "anonymous",
    "containsSensitiveData": false
  },
