    ]
  },
  "differentiation": {
    "content": "Keep authentic activity choice while protecting gaze access and repair.",
    "process": "Model key vocabulary, provide wait time, allow rehearsal/repetition, and accept multimodal communication.",
    "product": "Accept selected activity, repair use, or teacher observation of access fit.",
    "environment": "Use a calm, predictable, local-first layout with teacher controls separate from student choices.",
    "support": "Teaching, SLP, OT, family, and student/team review should personalise vocabulary and access before reliance."
  },
  "participationBarriers": [
    {
      "barrier": "Activity choice can become adult-controlled or too visually dense for gaze access.",
      "support": "Use six large targets, stable repair vocabulary, clear dwell progress, and keyboard fallback."
    }
  ],
  "evidencePlan": {
    "observable": [
      "activity choice",
      "help request",
      "different/repair selection",
      "successful dwell cancellation or reselection"
    ],
    "notJudgement": "Dwell timing and accidental cancellation reflect access tuning, not preference certainty.",
    "export": "Use anonymous teacher notes, print/portfolio evidence, or local CSV/report only when needed. Do not include diagnoses, behaviour details, family details, or school IDs."
  }
