  "teacherNotes": {
    "modeling": "Model choosing a shape, Help and Different. These original geometric symbols demonstrate offline image rendering; they are not a prescribed AAC symbol set.",
    "evidence": "Teacher can note whether the student initiates a choice, confirms/rejects an activity, asks for help, or uses Different to repair the offered choices.",
    "customisation": "Replace symbols with familiar representations after team review. Preserve chosen cell locations.",
    "access": "Default dwell is 1000 ms. Targets are arranged 2 by 3 with large buttons, visible dwell progress, pointer-leave cancellation, and keyboard fallback.",
    "caveat": "Draft classroom support only. Review with the teaching/SLP/OT team and test on the actual student device/access setup before relying on it."
  },
  "systemFit": {
    "reviewStatus": "team-input-needed",
    "existingSystem": "Confirm how this support sits alongside the student's established AAC system.",
    "vocabularyAndMotorPlan": "Confirm familiar vocabulary and stable locations before classroom use.",
    "symbolFamiliarity": "Confirm that each symbol or text representation is recognised and meaningful.",
    "accessCalibration": "Confirm access settings on the actual device with the student and team.",
    "positioningAndVision": "Confirm screen, mounting, seating, visual field, contrast and fatigue conditions.",
    "languageCultureVoice": "Confirm preferred language, culturally meaningful vocabulary and voice output.",
    "partnerSignals": "Confirm reliable yes/no, cancel, repair and partner-assisted signals."
  },
  "symbolStrategy": {
    "defaultSource": "Original geometric SVGs",
    "textFallback": true,
    "customMediaPolicy": "teacher-owned local media only unless explicitly approved",
    "notes": "Six embedded geometric SVG images exercise offline rendering. Help and Different symbols require learner/team review; this is an illustrative fixture.",
    "reviewRequired": true
  },
  "privacy": {
    "level": "anonymous",
    "containsSensitiveData": false
  },
  "attribution": [
    {
      "source": "Original geometric symbols",
      "licence": "MIT",
      "attribution": "Created for this repository. Help and Different representations require learner/team review."
    }
  ],
  "sett": {
    "student": "Student uses eye gaze/dwell, keyboard, touch, or partner interpretation to choose an activity and repair the choice if needed.",
    "environment": "Classroom device or AAC setup with large targets, reduced visual clutter, and no dependency on live internet during use.",
    "task": "Choose a class activity while keeping Help and Different available.",
    "tools": "Two-by-three gaze-safe board, 1000 ms dwell, pointer-leave cancellation, spoken labels, and text/emoji fallback."
  },
  "udl": {
    "engagement": [
      "Meaningful choice",
      "safe repair route",
      "wait time and partner response"
    ],
    "representation": [
