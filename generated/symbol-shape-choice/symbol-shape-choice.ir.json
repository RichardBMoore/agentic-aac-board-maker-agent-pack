  "schemaVersion": "0.4.0",
  "format": "agentic-aac-board-ir",
  "id": "symbol-shape-choice",
  "title": "Choose a shape",
  "purpose": "Illustrative symbol-rendering fixture: choose a shape, request help or something different. Team review is needed for learner familiarity.",
  "audience": {
    "ageBand": "school-age",
    "tone": "age-respectful",
    "locale": "en-AU"
