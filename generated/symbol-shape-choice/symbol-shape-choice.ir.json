    "profile": "eye-gaze-dwell",
    "minimumTargetSizePx": 150,
    "dwellTimeMs": 1000,
    "denseGazeTested": false,
    "visibleTargetLimit": 9,
    "setupTargetLimit": 3,
    "switchScanning": false,
    "scanSpeedMs": 1400,
    "scanPattern": "linear",
    "scanOrder": "dom-order",
    "audioCues": true
  },
