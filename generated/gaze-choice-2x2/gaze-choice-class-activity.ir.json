  "teacherNotes": {
    "modeling": "Model the board by saying and selecting options yourself: “I choose Art”, “Help please”, “Different”. Wait after modelling and accept gaze, gesture, voice, partner interpretation, or keyboard selection.",
    "evidence": "Teacher can note whether the student initiates a choice, confirms/rejects an activity, asks for help, or uses Different to repair the offered choices.",
    "customisation": "Replace the four activity labels/search terms with the real lesson choices. Keep Help and Different/Finished-style repair vocabulary stable where possible.",
    "access": "Default dwell is 1000 ms. Targets are arranged 2 by 3 with large buttons, visible dwell progress, pointer-leave cancellation, and keyboard fallback.",
    "caveat": "Draft classroom support only. Review with the teaching/SLP/OT team and test on the actual student device/access setup before relying on it."
  },
  "symbolStrategy": {
    "defaultSource": "ARASAAC search terms",
    "textFallback": true,
    "customMediaPolicy": "teacher-owned local media only unless explicitly approved",
    "notes": "This proof of concept uses text labels and emoji-style inline icons in HTML, with ARASAAC search terms recorded for later symbol replacement."
  },
